BKS_TERM ICON "assets/bks-term.ico"
#include "bks-version.h"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION BKS_VERSION_NUM
PRODUCTVERSION BKS_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x2L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BKS Lab\0"
            VALUE "FileDescription", "BKS Term accessible terminal\0"
            VALUE "FileVersion", BKS_VERSION_STR
            VALUE "InternalName", "bks-app\0"
            VALUE "OriginalFilename", "bks-app.exe\0"
            VALUE "ProductName", "BKS Term\0"
            VALUE "ProductVersion", BKS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
